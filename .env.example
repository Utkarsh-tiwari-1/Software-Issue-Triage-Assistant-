# `auto` uses OpenAI when OPENAI_API_KEY is set, otherwise deterministic local analysis.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# `auto` uses OpenAI embeddings when an API key is available, otherwise local feature hashing.
EMBEDDING_PROVIDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

DATABASE_PATH=./data/issues.sqlite3
CHROMA_PATH=./data/chroma
RETRIEVAL_K=5
DUPLICATE_THRESHOLD=0.82
API_KEY=
ALLOWED_ORIGINS=[]
LOG_LEVEL=INFO
